# To run this project, copy .env.example to .env and fill in your values

DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgres://db_user:your-password@localhost:5432/db_name

# If running with docker compose use 'db' as host
# DATABASE_URL=postgres://db_user:your-password@db:5432/db_name

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173