[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude =
    .git,
    __pycache__,
    .venv,
    env,
    migrations,
    build,
    dist

per-file-ignores =

    */admin.py: F401
    */models.py: F401
    */views.py: F401
    */tests.py: F401

    */settings/*.py: F401, F403, F405
